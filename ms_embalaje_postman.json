{
	"info": {
		"name": "MS Embalaje - SIVEBO",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8086"
		}
	],
	"item": [
		{
			"name": "Categorías de Embalaje",
			"item": [
				{
					"name": "Crear categoría",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nombreCategoria\": \"Cajas de cartón\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/categorias",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "categorias"]
						}
					}
				},
				{
					"name": "Listar todas las categorías",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/v1/categorias",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "categorias"]
						}
					}
				},
				{
					"name": "Obtener categoría por ID",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/v1/categorias/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "categorias", "1"]
						}
					}
				},
				{
					"name": "Actualizar categoría",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nombreCategoria\": \"Cajas de cartón reforzado\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/categorias/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "categorias", "1"]
						}
					}
				},
				{
					"name": "Eliminar categoría",
					"request": {
						"method": "DELETE",
						"url": {
							"raw": "{{baseUrl}}/api/v1/categorias/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "categorias", "1"]
						}
					}
				}
			]
		},
		{
			"name": "Artículos de Embalaje",
			"item": [
				{
					"name": "Crear artículo",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"idCat\": 1,\n  \"nombre\": \"Caja mediana 40x30x20\",\n  \"descripcion\": \"Caja de cartón corrugado tamaño mediano\",\n  \"precioVta\": 2500\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/articulos",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "articulos"]
						}
					}
				},
				{
					"name": "Listar todos los artículos",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/v1/articulos",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "articulos"]
						}
					}
				},
				{
					"name": "Obtener artículo por ID",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/v1/articulos/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "articulos", "1"]
						}
					}
				},
				{
					"name": "Listar artículos por categoría",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/v1/articulos/categoria/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "articulos", "categoria", "1"]
						}
					}
				},
				{
					"name": "Actualizar artículo",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"idCat\": 1,\n  \"nombre\": \"Caja mediana 40x30x20\",\n  \"descripcion\": \"Caja reforzada tamaño mediano\",\n  \"precioVta\": 3000\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/articulos/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "articulos", "1"]
						}
					}
				},
				{
					"name": "Desactivar artículo",
					"request": {
						"method": "PATCH",
						"url": {
							"raw": "{{baseUrl}}/api/v1/articulos/1/desactivar",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "articulos", "1", "desactivar"]
						}
					}
				}
			]
		},
		{
			"name": "Stock por Sucursal",
			"item": [
				{
					"name": "Crear registro de stock",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"idArt\": 1,\n  \"idSucursal\": 1,\n  \"cantidadDisponible\": 100\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/stock",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "stock"]
						}
					}
				},
				{
					"name": "Obtener stock por ID",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/v1/stock/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "stock", "1"]
						}
					}
				},
				{
					"name": "Listar stock por sucursal",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/v1/stock/sucursal/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "stock", "sucursal", "1"]
						}
					}
				},
				{
					"name": "Actualizar cantidad en stock",
					"request": {
						"method": "PATCH",
						"url": {
							"raw": "{{baseUrl}}/api/v1/stock/actualizar?idArt=1&idSucursal=1&cantidad=150",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "stock", "actualizar"],
							"query": [
								{ "key": "idArt", "value": "1" },
								{ "key": "idSucursal", "value": "1" },
								{ "key": "cantidad", "value": "150" }
							]
						}
					}
				},
				{
					"name": "Descontar stock por venta",
					"request": {
						"method": "PATCH",
						"url": {
							"raw": "{{baseUrl}}/api/v1/stock/descontar?idArt=1&idSucursal=1&cantidad=5",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "stock", "descontar"],
							"query": [
								{ "key": "idArt", "value": "1" },
								{ "key": "idSucursal", "value": "1" },
								{ "key": "cantidad", "value": "5" }
							]
						}
					}
				},
				{
					"name": "Verificar disponibilidad de stock",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/v1/stock/verificar?idArt=1&idSucursal=1&cantidadRequerida=10",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "stock", "verificar"],
							"query": [
								{ "key": "idArt", "value": "1" },
								{ "key": "idSucursal", "value": "1" },
								{ "key": "cantidadRequerida", "value": "10" }
							]
						}
					}
				}
			]
		}
	]
}
